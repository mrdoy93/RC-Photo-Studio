<Window x:Class="PrinterScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:PrinterScanner.Models"
        mc:Ignorable="d"
        Title="RC Printer &amp; Scanner"
        Icon="Assets/AppLogo.png"
        Width="760" Height="576" MinWidth="760" MinHeight="576"
        MaxWidth="760" MaxHeight="576"
        ResizeMode="CanMinimize"
        Topmost="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewMouseDown="Window_PreviewMouseDown"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="86" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/AppLogo.png" Width="32" Height="32"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="RC Printer &amp; Scanner" FontSize="19" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ScanSettingsButton" Content="Scan Settings"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,7,0"
                            Click="ScanSettingsButton_Click" />
                    <Button x:Name="PrintSettingsButton" Content="Print Settings"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,7,0"
                            Click="PrintSettingsButton_Click" />
                    <Button x:Name="ThemeToggleButton" Style="{StaticResource SecondaryButtonStyle}"
                            Content="☀  Light" Click="ThemeToggleButton_Click" MinWidth="88" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SettingsStorageBorder" Grid.Column="0" Visibility="Collapsed"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel x:Name="SettingsPanel" Margin="10,5">
                    <StackPanel x:Name="ScanSettingsPanel">
                    <Border Background="{DynamicResource SelectionBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,4">
                        <TextBlock Text="SCAN OPTIONS" Style="{StaticResource SectionHeaderTextStyle}" />
                    </Border>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Scanner" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ComboBox x:Name="ScannerCombo" Grid.Column="1" Style="{StaticResource CompactComboStyle}"
                                  SelectionChanged="ScannerCombo_SelectionChanged" />
                        <Button Grid.Column="2" Content="Refresh" Margin="6,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="RefreshButton_Click" />
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Source" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="SourceCombo" Style="{StaticResource CompactComboStyle}">
                                <ComboBoxItem Content="Flatbed" IsSelected="True" />
                                <ComboBoxItem Content="Automatic Document Feeder" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Scan Type" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="ScanTypeCombo" Style="{StaticResource CompactComboStyle}"
                                      AutomationProperties.Name="Scan type">
                                <ComboBoxItem Content="Color" IsSelected="True" />
                                <ComboBoxItem Content="True Gray" />
                                <ComboBoxItem Content="Gray (Error Diffusion)" />
                                <ComboBoxItem Content="Black &amp; White" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Resolution" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <RadioButton x:Name="Dpi150" GroupName="Dpi" Content="150" Tag="150" Style="{StaticResource DpiRadioStyle}" />
                            <RadioButton x:Name="Dpi200" GroupName="Dpi" Content="200" Tag="200" Style="{StaticResource DpiRadioStyle}" />
                            <RadioButton x:Name="Dpi300" GroupName="Dpi" Content="300" Tag="300" Style="{StaticResource DpiRadioStyle}" IsChecked="True" />
                            <RadioButton x:Name="Dpi600" GroupName="Dpi" Content="600" Tag="600" Style="{StaticResource DpiRadioStyle}" />
                            <TextBlock Text="DPI" VerticalAlignment="Center" Margin="3,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Text="Scan Size" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="PaperSizeCombo" Style="{StaticResource CompactComboStyle}">
                                <ComboBoxItem x:Name="A3ScanSizeItem" Content="A3" Visibility="Collapsed" />
                                <ComboBoxItem Content="A4" IsSelected="True" />
                                <ComboBoxItem x:Name="LegalScanSizeItem" Content="Legal" Visibility="Collapsed" />
                                <ComboBoxItem Content="Letter" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Compression" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="CompressionCombo" Style="{StaticResource CompactComboStyle}"
                                      SelectionChanged="CompressionCombo_SelectionChanged">
                                <ComboBoxItem Content="Smallest file" />
                                <ComboBoxItem Content="Balanced" IsSelected="True" />
                                <ComboBoxItem Content="High quality" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Continuous Scan" Style="{StaticResource FieldLabelStyle}" />
                            <CheckBox x:Name="ContinuousScanCheck" IsChecked="True" Content="On"
                                      Height="34" VerticalContentAlignment="Center"
                                      Style="{StaticResource ToggleCheckStyle}" Click="ContinuousScanCheck_Click" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Automatic JPG Folder" Style="{StaticResource FieldLabelStyle}" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SaveLocationText" Height="34" Padding="8,5" IsReadOnly="True"
                                 VerticalContentAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        <Button Grid.Column="1" Content="Browse" Margin="6,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="BrowseSaveLocationButton_Click" />
                    </Grid>

                    </StackPanel>
                    <StackPanel x:Name="PrintSettingsPanel" Visibility="Collapsed">
                    <Border Background="{DynamicResource SelectionBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,4">
                        <TextBlock Text="PRINT OPTIONS" Style="{StaticResource SectionHeaderTextStyle}" />
                    </Border>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Printer" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ComboBox x:Name="PrinterCombo" Grid.Column="1" Style="{StaticResource CompactComboStyle}"
                                  SelectionChanged="PrinterCombo_SelectionChanged" />
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Print Paper" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="PrintPaperSizeCombo" Style="{StaticResource CompactComboStyle}">
                                <ComboBoxItem x:Name="A3PrintSizeItem" Content="A3" Visibility="Collapsed" />
                                <ComboBoxItem Content="A4" IsSelected="True" />
                                <ComboBoxItem x:Name="LegalPrintSizeItem" Content="Legal" Visibility="Collapsed" />
                                <ComboBoxItem Content="Letter" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Print Color" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="PrintColorCombo" Style="{StaticResource CompactComboStyle}">
                                <ComboBoxItem Content="Color" IsSelected="True" />
                                <ComboBoxItem Content="Grayscale" />
                                <ComboBoxItem Content="Black &amp; White" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Print Quality" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="PrintQualityCombo" Style="{StaticResource CompactComboStyle}">
                                <ComboBoxItem Content="Draft" />
                                <ComboBoxItem Content="Normal" IsSelected="True" />
                                <ComboBoxItem Content="High" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="142" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Reduce / Convert Size" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="PrintReductionCombo" Style="{StaticResource CompactComboStyle}"
                                      SelectionChanged="PrintReductionCombo_SelectionChanged">
                                <ComboBoxItem Content="None (fit to selected paper)" IsSelected="True" />
                                <ComboBoxItem Content="A3 to Legal" />
                                <ComboBoxItem Content="A3 to A4" />
                                <ComboBoxItem Content="A3 to Letter" />
                                <ComboBoxItem Content="Legal to A4" />
                                <ComboBoxItem Content="Legal to Letter" />
                                <ComboBoxItem Content="A4 to Letter" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Copies" Style="{StaticResource FieldLabelStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="26" />
                                </Grid.ColumnDefinitions>
                                <Button Content="&#x2212;" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="0" AutomationProperties.Name="Decrease copies"
                                        Click="DecreaseCopiesButton_Click" />
                                <TextBox x:Name="PrintCopiesTextBox" Grid.Column="1" Text="1" MaxLength="3"
                                         Height="34" Margin="4,0" Padding="0" TextAlignment="Center"
                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                         FontWeight="Normal" AutomationProperties.Name="Number of copies"
                                         PreviewTextInput="PrintCopiesTextBox_PreviewTextInput"
                                         LostKeyboardFocus="PrintCopiesTextBox_LostKeyboardFocus"
                                         DataObject.Pasting="PrintCopiesTextBox_Pasting" />
                                <Button Grid.Column="2" Content="+" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="0" AutomationProperties.Name="Increase copies"
                                        Click="IncreaseCopiesButton_Click" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Driver Settings" Style="{StaticResource FieldLabelStyle}" />
                            <Button Content="Printer Properties" Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Stretch" Click="PrinterPropertiesButton_Click" />
                        </StackPanel>
                    </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="16,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="112" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Document Preview" FontSize="18" FontWeight="SemiBold" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="ZoomOutButton" Content="−" Width="30" Height="28" Padding="0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="ZoomOutButton_Click"
                                ToolTip="Zoom out" />
                        <TextBlock x:Name="ZoomLevelText" Text="100%" Width="48"
                                   TextAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <Button x:Name="ZoomInButton" Content="+" Width="30" Height="28" Padding="0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="ZoomInButton_Click"
                                ToolTip="Zoom in" />
                        <Button x:Name="ZoomFitButton" Content="Fit" Height="28" Padding="9,0" Margin="6,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="ZoomFitButton_Click"
                                ToolTip="Fit the page to the preview" />
                        <Border Background="{DynamicResource PreviewBackgroundBrush}"
                                CornerRadius="5" Padding="9,4" VerticalAlignment="Center">
                            <TextBlock x:Name="PageCounterText" Text="No pages" Foreground="{DynamicResource MutedTextBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource PreviewBackgroundBrush}" CornerRadius="7"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <TextBlock x:Name="EmptyPreviewText" Text="Select a scanner, then scan your first page"
                                   Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <ScrollViewer x:Name="PreviewScrollViewer" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto" PanningMode="Both"
                                      SizeChanged="PreviewScrollViewer_SizeChanged">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image x:Name="PreviewImage" Stretch="Fill" Margin="16" />
                                <Canvas x:Name="CropCanvas" Margin="16"
                                        Width="{Binding ActualWidth, ElementName=PreviewImage}"
                                        Height="{Binding ActualHeight, ElementName=PreviewImage}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="Transparent" Cursor="Cross" Visibility="Collapsed"
                                        MouseLeftButtonDown="CropCanvas_MouseLeftButtonDown"
                                        MouseMove="CropCanvas_MouseMove"
                                        MouseLeftButtonUp="CropCanvas_MouseLeftButtonUp">
                                    <Rectangle x:Name="CropSelectionRectangle" Visibility="Collapsed"
                                               Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                               Fill="#330D6EFD" />
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="PageList" ItemsSource="{Binding Pages}" SelectionChanged="PageList_SelectionChanged"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ScanPage}">
                                <StackPanel Width="72" Margin="3">
                                    <Border Height="72" Background="{DynamicResource ControlBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="3" />
                                    </Border>
                                    <TextBlock Text="{Binding DisplayNumber}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RotateButton" Content="↻  Rotate" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,7,0"
                                Click="RotateButton_Click" />
                        <Button x:Name="CropButton" Content="Crop" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,7,0"
                                Click="CropButton_Click" />
                        <Button x:Name="ApplyCropButton" Content="Apply Crop" Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,7,0" Visibility="Collapsed" Click="ApplyCropButton_Click" />
                        <Button x:Name="CancelCropButton" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,7,0" Visibility="Collapsed" Click="CancelCropButton_Click" />
                        <Button x:Name="DeleteButton" Content="Delete" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,7,0"
                                Click="DeleteButton_Click" />
                        <Button x:Name="RescanButton" Content="Rescan" Style="{StaticResource SecondaryButtonStyle}"
                                Click="RescanButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{DynamicResource SuccessBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Grid.Column="1" Text="Ready" Margin="8,0,14,0"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="DocumentPageCountText" Text="Pages: 0"
                                   Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                        <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}" Margin="8,0" />
                        <TextBlock x:Name="EstimatedSizeText" Text="PDF: 0 KB"
                                   Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <Border Padding="4" Margin="0,0,10,0" CornerRadius="7"
                            Background="{DynamicResource PreviewBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ScanButton" Content="Scan Next Page" Style="{StaticResource ScanButtonStyle}"
                                    Margin="0,0,6,0" Click="ScanButton_Click" />
                            <Button x:Name="FinishButton" Content="Finish &amp; Combine PDF" Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,6,0" Click="FinishButton_Click" />
                            <Button x:Name="SaveButton" Content="Save PDFs as ZIP" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="SaveButton_Click" />
                        </StackPanel>
                    </Border>
                    <Border Padding="4" CornerRadius="7"
                            Background="{DynamicResource PreviewBackgroundBrush}"
                            BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1">
                        <Button x:Name="PrintButton" Content="Print Now" Style="{StaticResource PrintButtonStyle}"
                                MinWidth="96" Click="PrintButton_Click"
                                ToolTip="Scan one page and send it directly to the selected printer." />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ScanProgressOverlay" Grid.RowSpan="3" Panel.ZIndex="100"
              Background="#72000000" Visibility="Collapsed">
            <Border Width="350" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="Scanning in progress" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="ScanProgressDetailText"
                               Text="Please wait while the page is acquired and processed."
                               Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,8,0,16" />
                    <Grid Height="24">
                        <ProgressBar x:Name="ScanProgressBar" Minimum="0" Maximum="100" Value="0"
                                     IsIndeterminate="False" Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource PreviewBackgroundBrush}" />
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                Padding="6,1" CornerRadius="4"
                                Background="{DynamicResource PanelBackgroundBrush}">
                            <TextBlock x:Name="ScanProgressPercentText" Text="0%"
                                       FontSize="11" FontWeight="Bold" />
                        </Border>
                    </Grid>
                    <Button x:Name="CancelScanButton" Content="Cancel Scan"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Center" Margin="0,14,0,0"
                            Click="CancelScanButton_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=ThemeToggleButton}"
               Placement="Bottom" HorizontalOffset="-390" VerticalOffset="6"
               AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="True">
            <Border x:Name="SettingsPopupHost" Width="480" Padding="2"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" />
        </Popup>
    </Grid>
</Window>
