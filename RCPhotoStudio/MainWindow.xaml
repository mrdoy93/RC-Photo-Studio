<Window x:Class="RCPhotoStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RC Photo Studio" Height="760" Width="1180" MinHeight="600" MinWidth="780"
        WindowStartupLocation="CenterScreen" Icon="/RCPhotoStudio;component/Assets/rc-logo.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/RCPhotoStudio;component/Assets/rc-logo.png" Width="56" Height="56" Stretch="Uniform" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="RC PHOTO STUDIO" FontSize="25" FontWeight="Bold"/>
                        <TextBlock Text="ID and photo package printing" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <ToggleButton x:Name="ThemeToggle" Grid.Column="1" Style="{StaticResource ThemeSwitchStyle}"
                              VerticalAlignment="Center" Checked="ThemeToggle_Changed" Unchecked="ThemeToggle_Changed"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource AccentBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10">
                        <TextBlock Text="Main Menu"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </Border>
                    <!-- Reserved partition for future menu controls and content. -->
                    <StackPanel x:Name="FutureMenuArea" Grid.Row="1" Margin="0,18,0,0"/>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
            <StackPanel Margin="20" VerticalAlignment="Center">
                <UniformGrid Columns="3" Width="804" HorizontalAlignment="Center">
                    <Button Width="252" Height="252" Margin="8" Click="RushId_Click" HorizontalContentAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Center">
                            <Image Source="/RCPhotoStudio;component/Assets/rush-id-menu.png" Width="118" Height="118"
                                   Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="RUSH ID Packages" FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <TextBlock Text="Open your ID package library" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Width="252" Height="252" Margin="8" Click="PhotoPackages_Click" HorizontalContentAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Center">
                            <Image Source="/RCPhotoStudio;component/Assets/photo-packages-menu.png" Width="118" Height="118"
                                   Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="Photo Packages" FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <TextBlock Text="Browse regular photo layouts" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Width="252" Height="252" Margin="8" Click="OpenPrinterWorkspace_Click" HorizontalContentAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Center">
                            <Image Source="/RCPhotoStudio;component/Assets/print-workspace-menu.png" Width="118" Height="118"
                                   Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="PVC Printing" FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <TextBlock Text="Preview paper and select printer" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Width="252" Height="252" Margin="8" Click="TicketPrinting_Click"
                            HorizontalContentAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Center">
                            <Image Source="/RCPhotoStudio;component/Assets/ticket-printing-menu.png" Width="118" Height="118"
                                   Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="Ticket Printing" FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <TextBlock Text="Print event and admission tickets" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Width="252" Height="252" Margin="8" Click="CreatePackage_Click" HorizontalContentAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Center">
                            <Image Source="/RCPhotoStudio;component/Assets/custom-package-menu.png" Width="118" Height="118"
                                   Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock Text="Package Custom Creation" FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            <TextBlock Text="Create layouts for Photo Packages" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <Grid Margin="0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Packages" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PackageCountText" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
                    </StackPanel>
                    <TextBox x:Name="SearchBox" Grid.Column="1" VerticalAlignment="Center" ToolTip="Search package name"
                             TextChanged="SearchBox_TextChanged"/>
                    <ComboBox x:Name="CategoryFilter" Grid.Column="3" VerticalAlignment="Center" SelectionChanged="CategoryFilter_SelectionChanged">
                        <ComboBoxItem Content="All packages" IsSelected="True"/>
                        <ComboBoxItem Content="Rush ID"/>
                        <ComboBoxItem Content="Photo"/>
                        <ComboBoxItem Content="Custom"/>
                    </ComboBox>
                </Grid>

                <ItemsControl x:Name="PackageList" Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="242" Height="245" Margin="0,0,16,16" Padding="15"
                                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="105"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="42"/>
                                    </Grid.RowDefinitions>
                                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8">
                                        <Grid>
                                            <TextBlock Text="▧" FontSize="54" Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding IconPath}" Stretch="Uniform" Margin="8"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="0,10,0,4">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CategoryDisplay}" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding PaperName}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
                                    </StackPanel>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="Open" Style="{StaticResource PrimaryButtonStyle}" Tag="{Binding}" Click="OpenPackage_Click" Margin="0,0,5,0"/>
                                        <Button Grid.Column="1" Content="Edit" Padding="8,6" Tag="{Binding}" Click="EditPackage_Click" Margin="0,0,5,0"/>
                                        <Button Grid.Column="2" Content="⧉" Padding="8,6" Tag="{Binding}" Click="DuplicatePackage_Click" ToolTip="Duplicate" Margin="0,0,5,0"/>
                                        <Button Grid.Column="3" Content="×" Padding="9,6" Tag="{Binding}" Click="DeletePackage_Click" ToolTip="Delete"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="Ready • Packages and settings are stored locally" Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center" Margin="28,0" FontSize="11"/>
        </Border>
    </Grid>
</Window>
