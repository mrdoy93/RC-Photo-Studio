<Window x:Class="RCPhotoStudio.Views.PrintWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RCPhotoStudio.Controls"
        Title="PVC Printing — RC Photo Studio" Height="820" Width="1320" MinHeight="600" MinWidth="760"
        WindowStartupLocation="CenterOwner" Icon="/RCPhotoStudio;component/Assets/rc-logo.png"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/RCPhotoStudio;component/Assets/rc-logo.png" Width="48" Height="48" Stretch="Uniform" Margin="0,0,11,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PackageTitle" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="WorkspaceSubtitle" Text="Drop photos, review the paper, then print directly"
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <ToggleButton x:Name="ThemeToggle" Grid.Column="1" Style="{StaticResource ThemeSwitchStyle}" VerticalAlignment="Center"
                              Checked="ThemeToggle_Changed" Unchecked="ThemeToggle_Changed"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightSidebarColumn" Width="330"/>
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Imported images" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Text="Drag a thumbnail onto a picture box"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,2,0,6"/>
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="−" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider x:Name="ThumbnailZoomSlider" Grid.Column="1" Minimum="38" Maximum="120" Value="120"
                                TickFrequency="2" ValueChanged="ThumbnailZoom_Changed"/>
                        <TextBlock Grid.Column="2" Text="+" FontSize="14" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>
                    <ListBox x:Name="PhotoList" Grid.Row="3" ItemsSource="{Binding Photos}" BorderThickness="0" Background="Transparent"
                             SelectionMode="Extended" SelectionChanged="PhotoList_SelectionChanged"
                             PreviewKeyDown="PhotoList_PreviewKeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="False">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:CenteredWrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{Binding DataContext.ThumbnailTileWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                        Height="{Binding DataContext.ThumbnailTileHeight, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                        Margin="2" Padding="3" Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="{Binding DataContext.ThumbnailImageSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                Height="{Binding DataContext.ThumbnailImageSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                Background="#333" CornerRadius="4" ClipToBounds="True">
                                            <Image Source="{Binding PreviewSource}" Stretch="Uniform"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}"
                                                   Width="{Binding DataContext.ThumbnailImageSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                   Margin="0,3,0,0" FontSize="8" LineHeight="9" MaxHeight="27"
                                                   TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Path}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="4" Margin="0,8,0,0" Padding="8,6"
                            Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions>
                            <Grid x:Name="PhotoEditScopePanel" Grid.ColumnSpan="2" Margin="0,0,0,6" Visibility="Collapsed">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Apply controls to" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="Choose a specific selection or every picture" FontSize="9"
                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                </StackPanel>
                                <ComboBox x:Name="SelectedPhotoApplyScopeBox" Grid.Column="1"
                                          SelectionChanged="SelectedPhotoApplyScope_Changed"/>
                            </Grid>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,8,5">
                                <TextBlock Text="Picture fit" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="Applies to selected preview picture(s)" FontSize="9" Foreground="{DynamicResource MutedTextBrush}"/>
                            </StackPanel>
                            <ComboBox x:Name="SelectedPhotoFitBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,5"
                                      SelectionChanged="SelectedPhotoFit_Changed"/>
                            <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="Picture border" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="Printed at 0.15 px" FontSize="9" Foreground="{DynamicResource MutedTextBrush}"/>
                            </StackPanel>
                            <ComboBox x:Name="SelectedPictureBorderBox" Grid.Row="2" Grid.Column="1"
                                      SelectionChanged="SelectedPictureBorder_Changed"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="5" Margin="0,8,0,0" Padding="8,5"
                            Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="Copies of selected" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="Saved separately for each picture" FontSize="9" Foreground="{DynamicResource MutedTextBrush}"/>
                            </StackPanel>
                            <Button x:Name="PhotoCopyMinusButton" Grid.Column="1" Content="−" Padding="0" Margin="0,0,5,0"
                                    Click="PhotoCopyMinus_Click"/>
                            <TextBox x:Name="PhotoCopyCountBox" Grid.Column="2" Text="1" TextAlignment="Center"
                                     VerticalContentAlignment="Center" TextChanged="PhotoCopyCount_TextChanged"/>
                            <Button x:Name="PhotoCopyPlusButton" Grid.Column="3" Content="+" Padding="0" Margin="5,0,0,0"
                                    Click="PhotoCopyPlus_Click"/>
                        </Grid>
                    </Border>

                    <Button x:Name="FillSelectedPicturesButton" Grid.Row="6" Content="Select Pictures to Fill"
                            Height="40" Margin="0,8,0,0" Style="{StaticResource PrimaryButtonStyle}"
                            Click="FillSelectedPictures_Click"/>

                    <Grid Grid.Row="7" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Content="+ Import" Click="BrowsePhotos_Click" Margin="0,0,5,0"/>
                        <Button x:Name="RemovePhotosButton" Grid.Column="1" Content="Remove"
                                Click="RemovePhoto_Click" Margin="5,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="#2B323D">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="50"/></Grid.RowDefinitions>
                <controls:PaperPreviewControl x:Name="PaperPreview" Margin="12"
                                              SelectedPhotoChanged="PaperPreview_SelectedPhotoChanged"/>
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#C9222933" CornerRadius="8" Padding="14,8"
                        IsHitTestVisible="False" x:Name="DropHint">
                    <TextBlock x:Name="DropHintText" Text="Drop JPG, PNG or BMP photos here" Foreground="White" FontSize="15"/>
                </Border>
                <Grid Grid.Row="1" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Content="‹ Previous" HorizontalAlignment="Right" x:Name="PreviousPageButton" Click="PreviousPage_Click"/>
                    <TextBlock x:Name="PageText" Grid.Column="2" Foreground="White" Margin="18,0" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Content="Next ›" HorizontalAlignment="Left" x:Name="NextPageButton" Click="NextPage_Click"/>
                    <Button x:Name="SavePdfButton" Grid.Column="5" Content="Save PDF" Padding="18,7"
                            Click="SavePdf_Click" Visibility="Collapsed"/>
                </Grid>
                <Border x:Name="PageSidebar" Grid.Column="1" Grid.RowSpan="2" Width="160"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1,0,0,0" Visibility="Collapsed">
                    <Grid Margin="10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Pages" FontSize="16" FontWeight="SemiBold" Margin="4,2,4,9"/>
                        <ListBox x:Name="PagePreviewList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                                 HorizontalContentAlignment="Stretch" SelectionChanged="PagePreviewList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,2,2,8">
                                        <controls:PaperPreviewControl Layout="{Binding Layout}" PageIndex="{Binding PageIndex}"
                                                                      ShowGrid="{Binding ShowGrid}" ShowCutGuides="{Binding ShowCutGuides}"
                                                                      ShowPictureBorders="{Binding ShowPictureBorders}"
                                                                      Height="138" IsHitTestVisible="False"/>
                                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="RightSidebarPanel" Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock Text="Layout" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock Text="Placement mode" Margin="0,0,0,4"/>
                        <ComboBox x:Name="PlacementBox" SelectionChanged="LayoutSetting_Changed" Margin="0,0,0,10"/>
                        <TextBlock x:Name="AmountLabel" Text="Package sets" Margin="0,0,0,4"/>
                        <TextBox x:Name="AmountBox" Text="1" TextChanged="LayoutSetting_Changed" Margin="0,0,0,12"/>

                        <TextBlock Text="Paper" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,12"/>
                        <TextBlock Text="Paper size" Margin="0,0,0,4"/>
                        <ComboBox x:Name="PaperBox" DisplayMemberPath="Name" SelectionChanged="LayoutSetting_Changed" Margin="0,0,0,10"/>
                        <TextBlock Text="Orientation" Margin="0,0,0,4"/>
                        <ComboBox x:Name="OrientationBox" SelectionChanged="LayoutSetting_Changed" Margin="0,0,0,10"/>
                        <WrapPanel Margin="0,0,0,10">
                            <CheckBox x:Name="GridToggle" Content="Grid guides" Checked="LayoutSetting_Changed" Unchecked="LayoutSetting_Changed" Margin="0,0,14,8"/>
                            <CheckBox x:Name="CutGuidesToggle" Content="Cut guides" Checked="LayoutSetting_Changed" Unchecked="LayoutSetting_Changed" Margin="0,0,14,8"/>
                            <CheckBox x:Name="PictureBorderToggle" Content="Print picture border"
                                      Checked="LayoutSetting_Changed" Unchecked="LayoutSetting_Changed"
                                      Margin="0,0,14,8" Visibility="Collapsed"/>
                            <CheckBox x:Name="BorderlessToggle" Content="Borderless" Checked="LayoutSetting_Changed" Unchecked="LayoutSetting_Changed"/>
                        </WrapPanel>
                        <TextBlock x:Name="LayoutSummary" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <Separator Margin="0,2,0,14"/>
                        <TextBlock Text="Printer" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock Text="Installed printer" Margin="0,0,0,4"/>
                        <ComboBox x:Name="PrinterBox" SelectionChanged="PrinterBox_SelectionChanged" Margin="0,0,0,5"/>
                        <TextBlock x:Name="PrinterStatus" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button Content="Refresh" Click="RefreshPrinters_Click" Margin="0,0,5,0"/>
                            <Button Grid.Column="1" Content="Printer Settings…" Click="PrinterSettings_Click" Margin="5,0,0,0"/>
                        </Grid>

                        <Button x:Name="PrintNowButton" Content="PRINT NOW" Height="48" FontSize="16"
                                Style="{StaticResource PrimaryButtonStyle}" Click="PrintNow_Click"/>
                        <TextBlock x:Name="AutoSaveNotice" Text="Changes are saved automatically. Close this window when finished."
                                   TextWrapping="Wrap" Foreground="{DynamicResource SuccessBrush}" FontSize="11"
                                   Margin="0,2,0,0" Visibility="Collapsed"/>
                        <TextBlock Text="Grid guides do not print. Enable Cut guides if you want dashed cutting lines on paper."
                                   TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,9,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
