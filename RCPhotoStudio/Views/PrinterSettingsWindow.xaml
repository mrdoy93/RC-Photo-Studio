<Window x:Class="RCPhotoStudio.Views.PrinterSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Printer Settings — RC Photo Studio" Width="560" MinWidth="540"
        SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Icon="/RCPhotoStudio;component/Assets/rc-logo.png">
    <Window.Resources>
        <Style x:Key="CompactComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MaxDropDownHeight" Value="230"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource AccentBrush}" CornerRadius="7" Padding="10,5" Margin="0,0,0,10">
            <TextBlock Text="PRINTER SETTINGS" Foreground="White" FontWeight="Bold" FontSize="13"/>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Printer" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
            <ComboBox x:Name="PrinterBox" Grid.Row="1" Style="{StaticResource CompactComboBoxStyle}"
                      DisplayMemberPath="DisplayName" SelectionChanged="PrinterBox_SelectionChanged"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <TextBlock Text="Print Paper" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
            <TextBlock Grid.Column="2" Text="Paper Type" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
            <ComboBox x:Name="PaperSizeBox" Grid.Row="1" Style="{StaticResource CompactComboBoxStyle}"
                      DisplayMemberPath="DisplayName"/>
            <ComboBox x:Name="PaperTypeBox" Grid.Row="1" Grid.Column="2" Style="{StaticResource CompactComboBoxStyle}"
                      DisplayMemberPath="Name"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <TextBlock Text="Print Color" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
            <TextBlock Grid.Column="2" Text="Print Quality" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
            <TextBlock Grid.Column="4" Text="Copies" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3"/>
            <ComboBox x:Name="ColorBox" Grid.Row="1" Style="{StaticResource CompactComboBoxStyle}"/>
            <ComboBox x:Name="QualityBox" Grid.Row="1" Grid.Column="2" Style="{StaticResource CompactComboBoxStyle}"
                      DisplayMemberPath="DisplayName"/>
            <Grid Grid.Row="1" Grid.Column="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                <Button Content="−" FontSize="18" Padding="0" Click="DecreaseCopies_Click"/>
                <TextBox x:Name="CopiesBox" Grid.Column="1" Margin="5,0" Text="1" Height="30" FontSize="12"
                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                         PreviewTextInput="CopiesBox_PreviewTextInput" TextChanged="CopiesBox_TextChanged"/>
                <Button Grid.Column="2" Content="+" FontSize="17" Padding="0" Click="IncreaseCopies_Click"/>
            </Grid>
        </Grid>

        <Border Grid.Row="4" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="7" Padding="10" VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="CapabilitySummary" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Text="Options are detected automatically from the selected printer driver."
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
                <Button x:Name="DriverPropertiesButton" Grid.Column="1" Content="Driver Properties…" Padding="14,7" Margin="12,0,0,0" FontSize="12"
                        Click="DriverProperties_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
            <Button Grid.Column="1" Content="Cancel" Width="90" Padding="12,7" FontSize="12" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="SaveButton" Grid.Column="2" Content="Save Settings" Width="120" Padding="12,7" FontSize="12" Style="{StaticResource PrimaryButtonStyle}"
                    Click="Save_Click"/>
        </Grid>
    </Grid>
</Window>
