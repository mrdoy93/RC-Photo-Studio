<Window x:Class="RCPhotoStudio.Views.TicketImageSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ticket Image Setup" Height="760" Width="1180" MinHeight="580" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown"
        Icon="/RCPhotoStudio;component/Assets/ticket-printing-menu.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/RCPhotoStudio;component/Assets/ticket-printing-menu.png"
                           Width="46" Height="46" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Ticket Image Setup" FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock Text="Set the ticket size and numbering boxes" FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="UndoButton" Grid.Column="1" Content="Undo" Width="88" Height="34"
                        IsEnabled="False" Click="Undo_Click" ToolTip="Undo last edit (Ctrl+Z)"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Grid Background="#2B323D" Margin="0">
                <Viewbox Margin="28" Stretch="Uniform">
                    <Border x:Name="TicketPreview" Width="550" Height="200"
                            Background="White" BorderBrush="#B4B9C2" BorderThickness="1"
                            ClipToBounds="True">
                        <Grid>
                            <Image x:Name="TicketImage" Stretch="Fill"/>
                            <Canvas x:Name="NumberingCanvas" Background="Transparent" ClipToBounds="True"
                                    MouseLeftButtonDown="NumberingCanvas_MouseLeftButtonDown"/>
                        </Grid>
                    </Border>
                </Viewbox>
            </Grid>

            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="14,12" VerticalAlignment="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="132"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ticket size" FontSize="17" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="SizeUnitBox" Grid.Column="1" Height="32"
                                      SelectionChanged="SizeUnit_Changed"/>
                        </Grid>
                        <TextBlock Text="Width and height" Margin="0,4,0,7" FontSize="9"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Width" FontSize="11" Margin="0,0,0,3"/>
                            <TextBlock Grid.Column="2" Text="Height" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox x:Name="TicketWidthBox" Grid.Row="1"
                                     TextAlignment="Center" TextChanged="TicketSizeValue_Changed"/>
                            <TextBox x:Name="TicketHeightBox" Grid.Row="1" Grid.Column="2"
                                     TextAlignment="Center" TextChanged="TicketSizeValue_Changed"/>
                        </Grid>
                        <Separator Margin="0,11,0,10"/>
                        <TextBlock Text="Text boxes" FontSize="15" FontWeight="SemiBold"/>
                        <Button Content="+ Add Text Box" Height="32" Margin="0,7,0,0"
                                Click="AddTextBox_Click"/>

                        <TextBlock Text="Type digits; use corner handles to move or resize. Press Delete to remove."
                                   TextWrapping="Wrap" Margin="0,5,0,9" FontSize="9"
                                   Foreground="{DynamicResource MutedTextBrush}"/>

                        <Border x:Name="SelectedBoxControls" Padding="10,8"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" IsEnabled="False">
                            <StackPanel>
                                <TextBlock Text="Selected text box" FontSize="13" FontWeight="SemiBold"
                                           Margin="0,0,0,7"/>
                                <TextBlock Text="Font family (Windows installed)" Margin="0,0,0,3" FontSize="9"/>
                                <ComboBox x:Name="FontFamilyBox" Height="32" IsTextSearchEnabled="True"
                                          MaxDropDownHeight="340" SelectionChanged="FontFamily_Changed">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="220" Margin="1,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="132"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding}" FontFamily="Segoe UI"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding}"/>
                                                <TextBlock Grid.Column="1" Text="Aa 123" FontFamily="{Binding}"
                                                           FontSize="14" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Font size (pt)" FontSize="10" Margin="0,0,0,3"/>
                                        <TextBox x:Name="FontSizeBox" TextAlignment="Center"
                                                 TextChanged="FontSize_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Rotate 90 degrees" FontSize="10" Margin="0,0,0,3"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="5"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Height="32" Padding="0" Click="RotateClockwise_Click"
                                                    ToolTip="Rotate 90° clockwise">
                                                <Viewbox Width="18" Height="18">
                                                    <Path Width="20" Height="20" Stretch="Uniform"
                                                          Stroke="{DynamicResource TextBrush}" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Data="M 7,3 C 3,4 2,8 4,12 C 6,16 11,17 15,14 M 7,3 L 3,2 M 7,3 L 6,7"/>
                                                </Viewbox>
                                            </Button>
                                            <Button Grid.Column="2" Height="32" Padding="0" Click="RotateCounterClockwise_Click"
                                                    ToolTip="Rotate 90° counterclockwise">
                                                <Viewbox Width="18" Height="18">
                                                    <Path Width="20" Height="20" Stretch="Uniform"
                                                          Stroke="{DynamicResource TextBrush}" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Data="M 13,3 C 17,4 18,8 16,12 C 14,16 9,17 5,14 M 13,3 L 17,2 M 13,3 L 14,7"/>
                                                </Viewbox>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Separator Margin="0,9,0,7"/>
                                <TextBlock Text="Text box appearance" FontSize="11" FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="88"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="34"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Background" FontSize="10" VerticalAlignment="Center"/>
                                    <Button x:Name="BackgroundColorButton" Grid.Column="2" Height="30"
                                            Click="BackgroundColor_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Border x:Name="BackgroundColorSwatch" Width="16" Height="16"
                                                    Margin="0,0,5,0" BorderBrush="#808080" BorderThickness="1"/>
                                            <TextBlock Text="Color" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <CheckBox x:Name="BackgroundTransparentBox" Grid.Column="4"
                                              Content="Transparent" VerticalAlignment="Center"
                                              Checked="BackgroundTransparent_Changed"
                                              Unchecked="BackgroundTransparent_Changed"/>

                                    <TextBlock Grid.Row="2" Text="Border" FontSize="10" VerticalAlignment="Center"/>
                                    <Button x:Name="BorderColorButton" Grid.Row="2" Grid.Column="2" Height="30"
                                            Click="BorderColor_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Border x:Name="BorderColorSwatch" Width="16" Height="16"
                                                    Margin="0,0,5,0" BorderBrush="#808080" BorderThickness="1"/>
                                            <TextBlock Text="Color" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <CheckBox x:Name="BorderTransparentBox" Grid.Row="2" Grid.Column="4"
                                              Content="Transparent" VerticalAlignment="Center"
                                              Checked="BorderTransparent_Changed"
                                              Unchecked="BorderTransparent_Changed"/>

                                    <TextBlock Grid.Row="4" Text="Font color" FontSize="10" VerticalAlignment="Center"/>
                                    <Button x:Name="FontColorButton" Grid.Row="4" Grid.Column="2"
                                            Grid.ColumnSpan="3" Height="30" Click="FontColor_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Border x:Name="FontColorSwatch" Width="16" Height="16"
                                                    Margin="0,0,5,0" BorderBrush="#808080" BorderThickness="1"/>
                                            <TextBlock Text="Choose color" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Grid.Row="6" Text="Thickness (px)" FontSize="10"
                                               VerticalAlignment="Center"/>
                                    <TextBox x:Name="BorderThicknessBox" Grid.Row="6" Grid.Column="2"
                                             Grid.ColumnSpan="3" TextAlignment="Center"
                                             ToolTip="Enter a value from 0.1 to 20 pixels"
                                             TextChanged="BorderThickness_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border Grid.Row="1" Padding="14,10"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Cancel" Height="34" IsCancel="True" Click="Cancel_Click"/>
                            <Button x:Name="DoneButton" Grid.Column="2" Content="OK" Height="34" IsDefault="True"
                                    Style="{StaticResource PrimaryButtonStyle}" Click="Done_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
